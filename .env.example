# CF Challenge — copy to .env and fill in real values. Never commit .env itself
# (see .gitignore). Existing os.environ values always win over .env (CI passes
# secrets directly), so a checked-in .env only matters for local runs.

# Required by scripts/fetch_results.py (the live weekly pipeline). Free key:
# https://collegefootballdata.com/key
CFB_API_KEY=

# Reserved for scripts/generate_commentary.py (STUB — not implemented yet).
OPENAI_API_KEY=

# Used ONLY by scripts/generate_owner_images.py, the standalone owner-portrait
# generator — NOT part of the live weekly pipeline. Get a key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
