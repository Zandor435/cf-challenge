# CF Challenge — copy to .env and fill in real values. Never commit .env itself
# (see .gitignore). Existing os.environ values always win over .env (CI passes
# secrets directly), so a checked-in .env only matters for local runs.

# Required by scripts/fetch_results.py (the live weekly pipeline). Free key:
# https://collegefootballdata.com/key
CFB_API_KEY=

# Reserved for scripts/generate_commentary.py — the weekly SVP column (persona
# DECIDED, ARCHITECTURE §12; voice in templates/svp_persona.md). Still STUB: no
# live call is wired, and --dry-run builds the prompt without touching the
# network, so this key is not needed to develop or test commentary.
OPENAI_API_KEY=

# Used ONLY by scripts/generate_owner_images.py, the standalone owner-portrait
# generator — NOT part of the live weekly pipeline. Get a key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required by email/send_email.py (the weekly recap email). REUSED from the
# wc-challenge project: same Resend account, same verified sender domain
# (mustardboy.xyz), same send-only key — so no new domain or DNS setup is needed,
# only a new `from` local-part. Revoking the key in Resend breaks BOTH projects.
# Keys: https://resend.com/api-keys   Domains: https://resend.com/domains
# In CI this comes from the repo secret RESEND_API_KEY, not from this file.
RESEND_API_KEY=
