# Secrets — never commit
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
*.pyo

# OS cruft
.DS_Store
Thumbs.db

# Engine outputs (docs/output-contract.md). Ignored by DEFAULT (regenerated each
# run off the shared cache) EXCEPT the three real groups below — GitHub Pages
# serves from docs/ on main, so their standings/projection/timeline JSON MUST be
# committed or the live site is empty. Any other/experimental group's output
# stays ignored until it is explicitly un-ignored here.
docs/data/*/standings.json
docs/data/*/projection.json
docs/data/*/timeline.json
!docs/data/panel/standings.json
!docs/data/panel/projection.json
!docs/data/panel/timeline.json
!docs/data/family/standings.json
!docs/data/family/projection.json
!docs/data/family/timeline.json
!docs/data/church/standings.json
!docs/data/church/projection.json
!docs/data/church/timeline.json
!docs/data/browns/standings.json
!docs/data/browns/projection.json
!docs/data/browns/timeline.json
# Test fixture output — a synthetic replay group, never committed to history.
docs/data/test/

# Commentary intermediates (groups/<group>/output/). Split by overwrite-vs-
# accumulate (playbook rule 5): week_packet.json and the dry-run prompt preview
# are REGENERATED from committed engine output every run, so they are ignored —
# committing them would just be a second copy of docs/data/<group>/ that can
# drift. The filed columns and column_memory.json ACCUMULATE (season-long
# continuity the pundit reads back), so they stay tracked.
groups/*/output/week_packet.json
groups/*/output/commentary_prompt_preview.txt

# Multi-year backtest cache for calibrate_spread.py. Fetched from CFBD on demand
# (data/backtest_cache/{lines,sp,games}.json), regenerable with --refresh. Kept
# OUT of the repo and OUT of the season-guarded production cache (data/cfbd_cache.json).
data/backtest_cache/

# Owner-portrait generator (scripts/generate_owner_images.py) — privacy:
# real photos of friends and un-approved generated art never get committed.
# A chosen winner is manually copied into docs/assets/portraits/.
#
# ANCHORED to the repo root on purpose. A bare `output/` matches a directory of
# that name at ANY depth, which silently swallowed groups/<group>/output/ — so
# the filed columns and column_memory.json the block above declares "stay
# tracked" were in fact unstageable, and every generated column would have died
# with the CI runner. generate_owner_images.py writes to ROOT/output/personas
# (its --out default) and repo-root output/ is the only such directory, so the
# leading slash costs nothing and restores the intended scope.
assets/source_photos/
/output/

# Playwright MCP scratch output (screenshots, console logs, a11y snapshots)
# written into the repo root during browser verification runs. Throwaway.
.playwright-mcp/

# Figma export of the site design — a large binary design INPUT, not source.
# Kept local; the built site it informed lives in docs/.
assets/Figma site code/

# Per-run API request tally (CLAUDE.md rule 6): cumulative daily count that
# resets on the UTC date rollover. Runtime state, rewritten by every
# generation run — it persists on disk, which is all the budget guard needs.
data/gemini_budget.json
